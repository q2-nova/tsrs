+/// Run one dump to completion, again (up to three attempts, 50 ms apart) if the kernel answered
+/// EBUSY. A dump is small (the links, addresses or routes of one host), so it is collected.
+async fn dump<S>(
+    make: impl Fn() -> S,
+) -> Vec<Result<Event, rtnetlink::Error>>
+where
+    S: Stream<Item = Result<Event, rtnetlink::Error>>,
+{
+    let mut attempt = 0;
+    loop {
+        let items: Vec<_> = make().collect().await;
+        attempt += 1;
+        if attempt < 3 && items.iter().any(|item| item.as_ref().is_err_and(is_busy)) {
+            tracing::warn!(attempt, "netlink dump busy, retrying");
+            tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+            continue;
+        }
+        return items;
+    }
+}
+
+fn init_state(handle: Handle) -> impl Stream<Item = io::Result<Event>> {
+    // The kernel allows one dump in progress per netlink socket; concurrent dumps fail with
+    // EBUSY and the node then reports no endpoints (upstream #485). Run them one after another.
+    futures_util::stream::once(async move {
+        let mut items = dump(|| link_state(handle.clone())).await;
+        items.extend(dump(|| addr_state(handle.clone())).await);
+        items.extend(dump(|| route_state(handle.clone())).await);
+        futures_util::stream::iter(items)
+    })
+    .flatten()
+    .map_err(io::Error::other)
 }
 
