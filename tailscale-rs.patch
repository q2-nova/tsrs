+    /// Outbound SYNs not yet answered, by (local, remote), with their sequence numbers.
+    #[derive(Default)]
+    pub struct PendingOpen {
+        flows: HashMap<(SocketAddr, SocketAddr), (u32, Instant)>,
+    }
+
+    impl PendingOpen {
+        /// Note an outbound packet; only connection-opening TCP SYNs are kept.
+        pub fn outbound(&mut self, packet: &[u8], now: Instant) {
+            let Some((local, remote, flags, seq)) = tcp_head(packet) else {
+                return;
+            };
+            if flags & (SYN | ACK) != SYN {
+                return;
+            }
+            self.flows.retain(|_, (_, at)| now.duration_since(*at) < PENDING_FOR);
+            if self.flows.len() >= MAX_PENDING
+                && let Some(oldest) = self.flows.iter().min_by_key(|(_, (_, at))| *at).map(|(k, _)| *k)
+            {
+                self.flows.remove(&oldest);
+            }
+            self.flows.insert((local, remote), (seq, now));
+        }
+
+        /// Note an inbound packet: a SYN|ACK or RST answers the pending open.
+        pub fn inbound(&mut self, packet: &[u8]) {
+            if self.flows.is_empty() {
+                return;
+            }
+            let Some((remote, local, flags, _)) = tcp_head(packet) else {
+                return;
+            };
+            if flags & (SYN | RST) != 0 {
+                self.flows.remove(&(local, remote));
+            }
+        }
+
+        /// The RST|ACK that fails the pending open a terminal TCP rejection names, if any.
+        pub fn reset_for(&mut self, rejected: &Rejected) -> Option<Vec<u8>> {
+            if rejected.proto != 6 {
+                return None;
+            }
+            LAST_REASON.store(u32::from(rejected.reason), Ordering::Relaxed);
+            if rejected.maybe_broken {
