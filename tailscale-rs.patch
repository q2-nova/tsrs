+                return None;
+            }
+            REJECTS.fetch_add(1, Ordering::Relaxed);
+            let (seq, _) = self.flows.remove(&(rejected.local, rejected.remote))?;
+            let packet = reset(rejected.remote, rejected.local, seq.wrapping_add(1))?;
+            RESETS.fetch_add(1, Ordering::Relaxed);
+            Some(packet)
+        }
