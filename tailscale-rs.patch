+/// TSMP rejections: when a peer's packet filter refuses a connection this node opened, the Go
+/// client answers the SYN with a TSMP "rejected connection" message (IP protocol 99, type `!`)
+/// instead of a TCP RST. Without handling, the local stack retransmits the SYN until its own
+/// connect timeout. This module turns the rejection into a RST|ACK for the pending connection,
+/// so the connect fails at once with a reset, as with a RST from the peer.
+pub mod tsmp_reject {
+    use std::{
+        collections::HashMap,
+        net::{IpAddr, SocketAddr},
+        sync::atomic::{AtomicU32, Ordering},
+        time::{Duration, Instant},
+    };
+
+    /// TSMP's IP protocol number.
+    pub const IP_PROTO_TSMP: u8 = 99;
+    /// The TSMP message type of a rejected connection.
+    pub const TYPE_REJECTED_CONN: u8 = b'!';
+    /// The flag bit marking a rejection that is not terminal (the peer is unsure).
+    pub const FLAG_MAYBE_BROKEN: u8 = 1;
+    const MAX_PENDING: usize = 64;
+    const PENDING_FOR: Duration = Duration::from_secs(30);
+
+    /// Terminal TCP rejections received, and resets delivered for them.
+    pub static REJECTS: AtomicU32 = AtomicU32::new(0);
+    #[allow(missing_docs)]
+    pub static RESETS: AtomicU32 = AtomicU32::new(0);
+    /// Non-terminal (maybe-broken) TCP rejections, and the reason byte of the last TCP rejection.
+    pub static MAYBE_BROKEN: AtomicU32 = AtomicU32::new(0);
+    #[allow(missing_docs)]
+    pub static LAST_REASON: AtomicU32 = AtomicU32::new(0);
+
+    /// A rejected flow as the TSMP message describes it, from this node's side.
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    pub struct Rejected {
+        /// IP protocol of the refused packet.
+        pub proto: u8,
+        /// The peer's reason byte (`A` ACL, `S` shields up, `F` IP forwarding, `W` host firewall).
+        pub reason: u8,
+        /// This node's end of the refused flow.
+        pub local: SocketAddr,
+        /// The peer's end.
+        pub remote: SocketAddr,
+        /// Not terminal: the peer is unsure; the connection may still succeed.
+        pub maybe_broken: bool,
+    }
+
+    /// Parse a TSMP rejection from the inbound packet's addresses (`src` the peer, `dst` this
+    /// node) and its IP payload. `None` for any other TSMP message or a short one.
+    pub fn parse(src: IpAddr, dst: IpAddr, payload: &[u8]) -> Option<Rejected> {
+        if payload.len() < 7 || payload[0] != TYPE_REJECTED_CONN {
+            return None;
+        }
+        let local_port = u16::from_be_bytes([payload[3], payload[4]]);
+        let remote_port = u16::from_be_bytes([payload[5], payload[6]]);
+        Some(Rejected {
+            proto: payload[1],
+            reason: payload[2],
+            local: SocketAddr::new(dst, local_port),
+            remote: SocketAddr::new(src, remote_port),
+            maybe_broken: payload.get(7).is_some_and(|f| f & FLAG_MAYBE_BROKEN != 0),
+        })
+    }
