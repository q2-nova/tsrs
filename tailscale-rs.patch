+    /// Inbound packets the control-provided filter accepted.
+    pub static ACCEPTED: AtomicU32 = AtomicU32::new(0);
+    /// Inbound TCP packets that are not connection-opening SYNs and that the filter alone
+    /// would have dropped: replies to connections this node opened.
+    pub static RETURN_ONLY: AtomicU32 = AtomicU32::new(0);
+    /// Inbound packets dropped.
+    pub static DROPPED: AtomicU32 = AtomicU32::new(0);
+
+    /// Dropped packets by class: TCP connection-opening SYN, UDP, ICMP (v4 or v6), TSMP
+    /// rejection notices (Tailscale's IP protocol 99, type `!`: the peer's filter refused
+    /// a connection this node opened), anything else.
+    pub static DROP_TCP_SYN: AtomicU32 = AtomicU32::new(0);
+    #[allow(missing_docs)]
+    pub static DROP_UDP: AtomicU32 = AtomicU32::new(0);
+    #[allow(missing_docs)]
+    pub static DROP_ICMP: AtomicU32 = AtomicU32::new(0);
+    #[allow(missing_docs)]
+    pub static DROP_TSMP_REJECT: AtomicU32 = AtomicU32::new(0);
+    #[allow(missing_docs)]
+    pub static DROP_OTHER: AtomicU32 = AtomicU32::new(0);
+    /// The last dropped packet: IP protocol number, IP version, TCP flag byte (0 if not
+    /// TCP), IPv4 destination as an integer (0 for IPv6; compared with the node's own
+    /// address by the caller and never printed), and the TSMP rejection reason byte (0 if
+    /// none; `A` ACL, `S` shields up, `F` IP forwarding, `W` host firewall).
+    pub static LAST_PROTO: AtomicU32 = AtomicU32::new(0);
+    #[allow(missing_docs)]
+    pub static LAST_IP_VERSION: AtomicU32 = AtomicU32::new(0);
+    #[allow(missing_docs)]
+    pub static LAST_TCP_FLAGS: AtomicU32 = AtomicU32::new(0);
+    #[allow(missing_docs)]
+    pub static LAST_DST_V4: AtomicU32 = AtomicU32::new(0);
+    #[allow(missing_docs)]
+    pub static LAST_TSMP_REASON: AtomicU32 = AtomicU32::new(0);
+
+    /// Record a dropped packet's class.
+    pub fn dropped(proto: u8, version: u32, tcp_flags: u8, dst_v4: u32, payload: &[u8]) {
+        let reject = proto == 99 && payload.first() == Some(&b'!');
+        let class = match proto {
+            6 => &DROP_TCP_SYN,
+            17 => &DROP_UDP,
+            1 | 58 => &DROP_ICMP,
+            99 if reject => &DROP_TSMP_REJECT,
+            _ => &DROP_OTHER,
+        };
+        class.fetch_add(1, Ordering::Relaxed);
+        LAST_PROTO.store(proto as u32, Ordering::Relaxed);
+        LAST_IP_VERSION.store(version, Ordering::Relaxed);
+        LAST_TCP_FLAGS.store(tcp_flags as u32, Ordering::Relaxed);
+        LAST_DST_V4.store(dst_v4, Ordering::Relaxed);
+        if reject {
+            LAST_TSMP_REASON.store(payload.get(2).copied().unwrap_or(0) as u32, Ordering::Relaxed);
+        }
+    }
+
+    /// (accepted, return_only, dropped) so far.
+    pub fn counts() -> (u32, u32, u32) {
+        (
+            ACCEPTED.load(Ordering::Relaxed),
+            RETURN_ONLY.load(Ordering::Relaxed),
+            DROPPED.load(Ordering::Relaxed),
+        )
+    }
+
+    /// Whether replies to this node's own TCP connections pass (default) or the
+    /// upstream stateless behaviour applies (`TSRS_STATELESS_FILTER=1`).
+    pub fn accept_tcp_replies() -> bool {
+        static ON: std::sync::LazyLock<bool> =
+            std::sync::LazyLock::new(|| std::env::var_os("TSRS_STATELESS_FILTER").is_none());
+        *ON
+    }
