+#[cfg(test)]
+mod q2_tests {
+    use super::*;
+
+    fn udp(port: u16) -> DynEndpoint {
+        DynEndpoint::udp(([192, 0, 2, 1], port).into())
+    }
+
+    #[test]
+    fn a_best_path_is_withdrawn_kept_or_replaced() {
+        let t = UnderlayTransportId(1);
+        let (a, b) = ((t, udp(1)), (t, udp(2)));
+        let ms = Duration::from_millis;
+        let none = HashMap::new();
+        // No probe answered: no path, whatever was published.
+        assert_eq!(choose_best_path(None, &none), None);
+        assert_eq!(choose_best_path(Some(&a), &none), None);
+        // The fastest when nothing was published.
+        let both = HashMap::from([(a.clone(), ms(9)), (b.clone(), ms(3))]);
+        assert_eq!(choose_best_path(None, &both), Some(b.clone()));
+        // The published path while it answers, though another is faster.
+        assert_eq!(choose_best_path(Some(&a), &both), Some(a.clone()));
+        // Another when the published one stopped answering.
+        let only_b = HashMap::from([(b.clone(), ms(20))]);
+        assert_eq!(choose_best_path(Some(&a), &only_b), Some(b));
+    }
+}
