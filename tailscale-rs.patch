+/// q2: transports removed because their queue was closed (`send_batches`).
+pub static TRANSPORTS_CLOSED: AtomicU32 = AtomicU32::new(0);
+
+/// Send each batch to its transport's queue.
+///
+/// q2: a transport whose receiving end is gone (its task or actor ended, for instance when the
+/// runtime stops its children) is removed and its packets are dropped, rather than a panic.
+fn send_batches<K, T>(queues: &mut HashMap<K, Tx<T>>, batches: impl IntoIterator<Item = (K, T)>)
+where
+    K: Eq + core::hash::Hash + core::fmt::Debug,
+{
+    for (id, batch) in batches {
+        let Some(queue) = queues.get(&id) else {
+            continue;
+        };
+        if queue.send(batch).is_err() {
+            tracing::warn!(transport_id = ?id, "transport queue closed: transport removed, packets dropped");
+            queues.remove(&id);
+            TRANSPORTS_CLOSED.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
         }
     }
 }
