+/// forgets the peers' direct paths.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct LinkChange {
+    /// Counts link changes from 1 (`ts_control::q2::LINK_CHANGES`).
+    pub generation: u32,
+}
